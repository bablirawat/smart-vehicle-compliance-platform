{
  "info": {
    "name": "Smart Vehicle Compliance & Journey Management Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"operator@sitea.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/v1/auth/login" }
      }
    },
    {
      "name": "Events - Vehicle Entry (ANPR)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"site_id\": 1,\n  \"camera_id\": 1,\n  \"vehicle_number\": \"DL01AB1234\",\n  \"confidence\": 0.95\n}"
        },
        "url": { "raw": "http://localhost:8000/api/v1/events/vehicle-entry" }
      }
    },
    {
      "name": "Events - Vehicle Exit",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"site_id\": 1,\n  \"camera_id\": 2,\n  \"journey_id\": 1\n}"
        },
        "url": { "raw": "http://localhost:8000/api/v1/events/vehicle-exit" }
      }
    },
    {
      "name": "Dashboard - KPIs",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "http://localhost:8000/api/v1/dashboard/kpis?site_id=1" }
      }
    },
    {
      "name": "Journeys - Transition State",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"target_state\": \"IN_SERVICE\",\n  \"reason\": \"Started inspection\"\n}"
        },
        "url": { "raw": "http://localhost:8000/api/v1/journeys/1/transition" }
      }
    }
  ]
}
